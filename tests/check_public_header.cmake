# Always runnable, including native-only builds without Python.
get_filename_component(PROJECT_DIR "${PROJECT_DIR}" ABSOLUTE)
file(GLOB public_headers RELATIVE "${PROJECT_DIR}/include" "${PROJECT_DIR}/include/*.h")
if(NOT public_headers STREQUAL "FPAnalyzer.h")
    message(FATAL_ERROR "The sole public header must be FPAnalyzer.h: ${public_headers}")
endif()
file(READ "${PROJECT_DIR}/include/FPAnalyzer.h" header)
string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" declarations "${header}")
string(REGEX REPLACE "//[^\n]*" "" declarations "${declarations}")
if(declarations MATCHES "#|__declspec|__attribute__|__cdecl|FP_API|FP_CALL|extern|std::")
    message(FATAL_ERROR "FPAnalyzer.h must contain plain C declarations without export/calling-convention macros or C++ constructs")
endif()
string(REGEX MATCHALL "int[ \t\r\n]+FP_[A-Za-z0-9_]+[ \t\r\n]*\\(" prototypes "${declarations}")
set(names)
foreach(prototype IN LISTS prototypes)
    string(REGEX MATCH "FP_[A-Za-z0-9_]+" name "${prototype}")
    list(APPEND names "${name}")
endforeach()
list(SORT names)
set(required FP_AnalyzeFrameU16 FP_AnalyzeFrameU16WithMethod FP_GetApiVersion)
if(NOT names STREQUAL required)
    message(FATAL_ERROR "Public function declarations changed: update the ABI checks for ${names}")
endif()
# Fixed array notation is documentation, not a LabVIEW allocation directive.
# Keep it explicit while compiled ABI tests check pointer order and constness.
foreach(array_contract IN ITEMS "roi_in[3]" "roi_out[3]" "metrics_out[4]")
    string(FIND "${declarations}" "${array_contract}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing public array contract: ${array_contract}")
    endif()
endforeach()
foreach(export_file IN ITEMS src/FPAnalyzer.def src/FPAnalyzer.map)
    file(READ "${PROJECT_DIR}/${export_file}" exports)
    string(REGEX MATCHALL "FP_[A-Za-z0-9_]+" exported_names "${exports}")
    list(SORT exported_names)
    if(NOT exported_names STREQUAL names)
        message(FATAL_ERROR "${export_file} does not match FPAnalyzer.h: ${exported_names}")
    endif()
endforeach()

if(DEFINED PACKAGE_DIR)
    get_filename_component(PACKAGE_DIR "${PACKAGE_DIR}" ABSOLUTE)
    file(GLOB installed_headers RELATIVE "${PACKAGE_DIR}/include" "${PACKAGE_DIR}/include/*")
    if(NOT installed_headers STREQUAL "FPAnalyzer.h")
        message(FATAL_ERROR "Distribution must contain only FPAnalyzer.h in include/: ${installed_headers}")
    endif()
    file(SHA256 "${PROJECT_DIR}/include/FPAnalyzer.h" source_hash)
    file(SHA256 "${PACKAGE_DIR}/include/FPAnalyzer.h" installed_hash)
    if(NOT source_hash STREQUAL installed_hash)
        message(FATAL_ERROR "The installed header differs from FPAnalyzer.h")
    endif()
    if(CMAKE_HOST_WIN32 AND NOT EXISTS "${PACKAGE_DIR}/bin/FPAnalyzer.dll")
        message(FATAL_ERROR "The Windows distribution must contain FPAnalyzer.dll")
    endif()
endif()
message(STATUS "Public header format, names and export lists verified")
