file(READ "${PROJECT_DIR}/include/FPFringe.h" header)
string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" declarations "${header}")
if(declarations MATCHES "#|__declspec|__attribute__|__cdecl|extern|std::|FPF_API|FPF_CALL")
    message(FATAL_ERROR "FPFringe.h must remain plain C without platform macros")
endif()
if(declarations MATCHES "\\[[0-9]+\\]")
    message(FATAL_ERROR "Keep new array parameters unsized for the NI Wizard; document lengths separately")
endif()
string(REGEX MATCHALL "FPF_[A-Za-z0-9_]+[ \t\r\n]*\\(" prototypes "${declarations}")
set(names)
foreach(prototype IN LISTS prototypes)
    string(REGEX MATCH "FPF_[A-Za-z0-9_]+" name "${prototype}")
    list(APPEND names "${name}")
endforeach()
list(SORT names)
set(expected FPF_AnalyzeAsymmetryU16 FPF_AnalyzeU16 FPF_CheckFringesU16 FPF_FindCenteredRoiU16 FPF_GetApiVersion)
if(NOT names STREQUAL expected)
    message(FATAL_ERROR "FPFringe declarations changed: ${names}")
endif()
foreach(export_file IN ITEMS src/FPFringe.def src/FPFringe.map)
    file(READ "${PROJECT_DIR}/${export_file}" exports)
    string(REGEX MATCHALL "FPF_[A-Za-z0-9_]+" exported "${exports}")
    list(SORT exported)
    if(NOT exported STREQUAL expected)
        message(FATAL_ERROR "${export_file} differs from public declarations")
    endif()
endforeach()
if(DEFINED PACKAGE_DIR)
    file(SHA256 "${PROJECT_DIR}/include/FPFringe.h" original)
    file(SHA256 "${PACKAGE_DIR}/include/FPFringe.h" installed)
    if(NOT original STREQUAL installed)
        message(FATAL_ERROR "Packaged FPFringe.h differs from source")
    endif()
    if(CMAKE_HOST_WIN32 AND NOT EXISTS "${PACKAGE_DIR}/bin/FPFringe.dll")
        message(FATAL_ERROR "Missing packaged FPFringe.dll")
    endif()
endif()
message(STATUS "FPFringe five plain-C declarations, export definitions and package verified")
